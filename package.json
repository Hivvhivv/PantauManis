{
  "name": "pantaumanis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:dev": "tsx scripts/db-dev.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "superadmin:create": "tsx scripts/superadmin-create.ts",
    "superadmin:reset-password": "tsx scripts/superadmin-reset-password.ts",
    "db:status:prod": "dotenv -e .env.supabase -v DOTENV_CONFIG_PATH=.env.supabase -- prisma migrate status",
    "db:deploy:prod": "dotenv -e .env.supabase -v DOTENV_CONFIG_PATH=.env.supabase -- prisma migrate deploy",
    "superadmin:create:prod": "dotenv -e .env.supabase -v DOTENV_CONFIG_PATH=.env.supabase -- tsx scripts/superadmin-create.ts",
    "superadmin:reset-password:prod": "dotenv -e .env.supabase -v DOTENV_CONFIG_PATH=.env.supabase -- tsx scripts/superadmin-reset-password.ts",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "chart.js": "4.5.0",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "next": "15.5.27",
    "papaparse": "5.7.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "11.0.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "prettier": "3.9.10",
    "prisma": "^7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
