# Salin ke .env lalu isi. Jangan pernah commit .env.

# Basis data PostgreSQL yang dipakai aplikasi saat berjalan.
# - Lokal: `npm run db:dev` menjalankan Postgres di port 54329.
# - Supabase (production): pooler mode transaksi, port 6543, dengan ?pgbouncer=true.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/pantaumanis"

# Koneksi langsung untuk migration (Prisma CLI). Kosongkan di lokal (otomatis memakai DATABASE_URL).
# - Supabase: session pooler port 5432 (atau koneksi langsung db.<project>.supabase.co:5432).
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# URL publik aplikasi (dipakai di kartu kode dan QR).
APP_URL="http://localhost:3000"

# Secret HMAC untuk kode akses (ADR-004). Minimal 32 byte acak, base64.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCESS_CODE_HMAC_SECRET=""

# Kunci AES-256-GCM untuk kode akses (ADR-004). Tepat 32 byte, base64. HARUS berbeda dari secret HMAC.
ACCESS_CODE_ENC_KEY=""

# Penyimpanan gambar materi edukasi (ADR-008).
# - local (default): folder lokal (%LOCALAPPDATA%\pantaumanis\uploads atau PM_UPLOAD_DIR), untuk dev/test.
# - supabase: Supabase Storage, bucket publik. Service role key HANYA di server, jangan di browser.
STORAGE_DRIVER="local"
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="edukasi"
