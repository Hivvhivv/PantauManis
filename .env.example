# Salin ke .env lalu isi. Jangan pernah commit .env.

# Basis data PostgreSQL. Untuk dev lokal, `npm run db:dev` menjalankan Postgres di port 54329.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/pantaumanis"

# URL publik aplikasi (dipakai di kartu kode dan QR).
APP_URL="http://localhost:3000"

# Secret HMAC untuk kode akses (ADR-004). Minimal 32 byte acak, base64.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCESS_CODE_HMAC_SECRET=""

# Kunci AES-256-GCM untuk kode akses (ADR-004). Tepat 32 byte, base64. HARUS berbeda dari secret HMAC.
ACCESS_CODE_ENC_KEY=""
