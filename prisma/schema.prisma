// Skema PantauManis. Semua perubahan WAJIB lewat migration (`npm run db:migrate`).
// Nama tabel/kolom snake_case, waktu disimpan UTC (timestamptz). Lihat ADR-002.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  superadmin
  admin

  @@map("staff_role")
}

/// Akun Admin dan Superadmin. Terpisah dari responden (ADR-003).
model StaffUser {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String    @db.VarChar(100)
  email              String    @unique @db.VarChar(254)
  passwordHash       String    @map("password_hash")
  role               StaffRole
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  sessions           StaffSession[]
  createdRespondents Respondent[]

  @@map("staff_users")
}

/// Sesi staf: berakhir setelah 2 jam tidak aktif atau 12 jam sejak login.
model StaffSession {
  id          String   @id @default(uuid()) @db.Uuid
  staffUserId String   @map("staff_user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.Char(64)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@map("staff_sessions")
}

enum AccessStatus {
  active
  inactive

  @@map("access_status")
}

/// Akun Responden. Tidak menyimpan nama lengkap. Kode akses: lihat ADR-004.
model Respondent {
  id                  String       @id @default(uuid()) @db.Uuid
  /// ID Responden / label penelitian, mis. R001.
  label               String       @unique @map("respondent_code_label") @db.VarChar(20)
  initials            String?      @db.VarChar(10)
  /// HMAC-SHA256 kode akses (hex). Dipakai untuk login dan cek keunikan.
  accessCodeHmac      String       @unique @map("access_code_hmac") @db.Char(64)
  /// Kode akses terenkripsi AES-256-GCM (format v1:iv:tag:ciphertext).
  accessCodeEncrypted String       @map("access_code_encrypted")
  accessStatus        AccessStatus @default(active) @map("access_status")
  consentAt           DateTime?    @map("consent_at") @db.Timestamptz(3)
  startDate           DateTime?    @map("start_date") @db.Date
  createdById         String?      @map("created_by") @db.Uuid
  notes               String?      @db.VarChar(2000)
  lastActiveAt        DateTime?    @map("last_active_at") @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(3)

  /// Hari ke-1 penelitian = tanggal pretest dikirim (Asia/Jakarta). Null = belum pretest (BR-01).
  dayOneDate          DateTime?    @map("day_one_date") @db.Date

  createdBy       StaffUser?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sessions        RespondentSession[]
  consumptionLogs ConsumptionLog[]
  dailyStatuses   DailyStatus[]
  responses       QuestionnaireResponse[]
  goals           Goal[]
  educationProgress EducationProgress[]

  @@index([deletedAt, accessStatus])
  @@map("respondents")
}

/// Sesi login kode akses: berlaku 30 hari sejak login.
model RespondentSession {
  id           String   @id @default(uuid()) @db.Uuid
  respondentId String   @map("respondent_id") @db.Uuid
  tokenHash    String   @unique @map("token_hash") @db.Char(64)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  respondent Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@index([respondentId])
  @@map("respondent_sessions")
}

enum LoginKind {
  staff
  code

  @@map("login_kind")
}

/// Percobaan login, dasar rate limit per IP, per email, dan global (ADR-003).
/// Tidak pernah menyimpan kode akses atau kata sandi.
model LoginAttempt {
  id        String    @id @default(uuid()) @db.Uuid
  kind      LoginKind
  ip        String    @db.VarChar(64)
  /// HMAC email (khusus staf), bukan email asli.
  emailHash String?   @map("email_hash") @db.Char(64)
  success   Boolean
  /// true jika percobaan ditolak oleh rate limit tanpa diperiksa.
  blocked   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([kind, ip, createdAt])
  @@index([kind, emailHash, createdAt])
  @@index([kind, success, createdAt])
  @@map("login_attempts")
}

/// Peringatan keamanan untuk banner Superadmin.
model SecurityAlert {
  id               String    @id @default(uuid()) @db.Uuid
  type             String    @db.VarChar(50)
  details          Json?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  acknowledgedById String?   @map("acknowledged_by") @db.Uuid
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(3)

  @@index([type, createdAt])
  @@map("security_alerts")
}

enum ActorType {
  staff
  respondent
  system

  @@map("actor_type")
}

/// Log audit. Hanya bisa ditambah: trigger di basis data menolak UPDATE dan DELETE.
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String    @db.VarChar(64)
  targetType String?   @map("target_type") @db.VarChar(32)
  targetId   String?   @map("target_id") @db.Uuid
  ip         String?   @db.VarChar(64)
  /// Detail tambahan. Tidak boleh berisi kode akses, kata sandi, token, atau jawaban kuesioner.
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Pengaturan penelitian (PRD FR-S-04). Nilai default diisi oleh migration.
model StudySetting {
  key       String   @id @db.VarChar(64)
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("study_settings")
}

/// Referensi minuman untuk estimasi gula (FR-A-06). Dikelola Admin.
model BeverageType {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @unique @db.VarChar(60)
  /// Ikon (emoji) untuk ubin pilihan di form pencatatan.
  icon                 String   @default("🥤") @db.VarChar(16)
  defaultVolumeMl      Int      @map("default_volume_ml")
  /// Perkiraan gula (gram) per sajian standar (default_volume_ml).
  sugarGPerServing     Float    @map("sugar_g_per_serving")
  /// Apakah pilihan tingkat gula (normal/less/no sugar) relevan untuk jenis ini.
  sugarLevelApplicable Boolean  @default(true) @map("sugar_level_applicable")
  source               String?  @db.VarChar(300)
  /// true = nilai masih contoh dan perlu diverifikasi peneliti sebelum dipakai.
  needsVerification    Boolean  @default(true) @map("needs_verification")
  isActive             Boolean  @default(true) @map("is_active")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  logs ConsumptionLog[]

  @@map("beverage_types")
}

enum SugarLevel {
  normal
  less
  none

  @@map("sugar_level")
}

/// Satu baris per minuman (FR-R-02). Hapus = soft delete agar jejak perubahan tetap ada.
model ConsumptionLog {
  id             String      @id @default(uuid()) @db.Uuid
  respondentId   String      @map("respondent_id") @db.Uuid
  beverageTypeId String      @map("beverage_type_id") @db.Uuid
  volumeMl       Int         @map("volume_ml")
  servings       Int
  sugarLevel     SugarLevel? @map("sugar_level")
  /// Perkiraan gula (gram) dihitung saat dibuat/diubah; tidak berubah bila referensi diedit.
  sugarGSnapshot Float       @map("sugar_g_snapshot")
  consumedAt     DateTime    @map("consumed_at") @db.Timestamptz(3)
  /// Tanggal minum menurut Asia/Jakarta.
  localDate      DateTime    @map("local_date") @db.Date
  studyDay       Int         @map("study_day")
  isBackfill     Boolean     @default(false) @map("is_backfill")
  /// Dicatat setelah hari terakhir periode penelitian (ADR-005).
  isOutOfPeriod  Boolean     @default(false) @map("is_out_of_period")
  note           String?     @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)

  respondent   Respondent   @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  beverageType BeverageType @relation(fields: [beverageTypeId], references: [id])

  @@index([respondentId, localDate])
  @@map("consumption_logs")
}

enum DayStatusValue {
  filled
  zero

  @@map("day_status")
}

/// Status per hari. Tidak ada baris = "Belum diisi"; zero = "Nol" (BR-02, ADR-005).
model DailyStatus {
  id           String         @id @default(uuid()) @db.Uuid
  respondentId String         @map("respondent_id") @db.Uuid
  date         DateTime       @db.Date
  studyDay     Int            @map("study_day")
  status       DayStatusValue
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  respondent Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@unique([respondentId, date])
  @@map("daily_status")
}

enum QuestionnaireType {
  pretest
  posttest

  @@map("questionnaire_type")
}

enum QuestionType {
  likert
  choice
  text

  @@map("question_type")
}

enum ResponseStatus {
  draft
  submitted

  @@map("response_status")
}

/// Instrumen kuesioner. Hanya satu versi aktif per jenis.
model Questionnaire {
  id            String            @id @default(uuid()) @db.Uuid
  type          QuestionnaireType
  version       Int
  title         String            @db.VarChar(200)
  intro         String?
  /// true = butir masih contoh; ganti dengan instrumen final sebelum pilot.
  isPlaceholder Boolean           @default(false) @map("is_placeholder")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  questions Question[]
  responses QuestionnaireResponse[]

  @@unique([type, version])
  @@map("questionnaires")
}

model Question {
  id              String       @id @default(uuid()) @db.Uuid
  questionnaireId String       @map("questionnaire_id") @db.Uuid
  order           Int
  text            String
  type            QuestionType
  /// Pilihan jawaban: [{ value, label, score }]. Kosong untuk isian.
  options         Json?
  required        Boolean      @default(true)

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@unique([questionnaireId, order])
  @@map("questions")
}

/// Satu per responden per kuesioner. Setelah submitted, terkunci (BR-07).
model QuestionnaireResponse {
  id              String         @id @default(uuid()) @db.Uuid
  respondentId    String         @map("respondent_id") @db.Uuid
  questionnaireId String         @map("questionnaire_id") @db.Uuid
  status          ResponseStatus @default(draft)
  score           Float?
  startedAt       DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedAt     DateTime?      @map("submitted_at") @db.Timestamptz(3)

  respondent    Respondent    @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id])
  answers       Answer[]

  @@unique([respondentId, questionnaireId])
  @@map("questionnaire_responses")
}

model Answer {
  id         String @id @default(uuid()) @db.Uuid
  responseId String @map("response_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  value      String @db.VarChar(2000)

  response QuestionnaireResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question Question              @relation(fields: [questionId], references: [id])

  @@unique([responseId, questionId])
  @@map("answers")
}

enum GoalMetric {
  drinks
  sugar

  @@map("goal_metric")
}

/// Target pribadi responden (FR-R-06). Satu target aktif (valid_to kosong); riwayat disimpan.
/// Target boleh diubah paling cepat 7 hari setelah perubahan terakhir.
model Goal {
  id           String     @id @default(uuid()) @db.Uuid
  respondentId String     @map("respondent_id") @db.Uuid
  metric       GoalMetric
  targetValue  Float      @map("target_value")
  validFrom    DateTime   @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo      DateTime?  @map("valid_to") @db.Timestamptz(3)

  respondent Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)

  @@index([respondentId, validFrom])
  @@map("goals")
}

enum MaterialStatus {
  draft
  published

  @@map("material_status")
}

/// Materi edukasi (FR-A-05). Isi dalam Markdown; gambar di storage, video lewat tautan YouTube.
model EducationMaterial {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(150)
  summary     String         @db.VarChar(300)
  /// Isi materi dalam Markdown (dirender tanpa HTML mentah).
  body        String
  icon        String         @default("📘") @db.VarChar(16)
  /// Kunci file gambar di storage (mis. edukasi/<uuid>.webp).
  imageKey    String?        @map("image_key") @db.VarChar(200)
  imageAlt    String?        @map("image_alt") @db.VarChar(200)
  /// Tautan video YouTube (opsional).
  videoUrl    String?        @map("video_url") @db.VarChar(300)
  source      String?        @db.VarChar(500)
  /// Kosong = langsung terbuka; N = terbuka mulai hari ke-N penelitian.
  unlockDay   Int?           @map("unlock_day")
  sortOrder   Int            @default(0) @map("sort_order")
  status      MaterialStatus @default(draft)
  createdById String?        @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)

  questions EducationQuizQuestion[]
  progress  EducationProgress[]

  @@index([status, sortOrder])
  @@map("education_materials")
}

/// Soal kuis pilihan ganda (0–3 per materi), satu jawaban benar.
model EducationQuizQuestion {
  id           String @id @default(uuid()) @db.Uuid
  materialId   String @map("material_id") @db.Uuid
  order        Int
  text         String @db.VarChar(500)
  /// Daftar opsi jawaban (2–4 teks).
  options      Json
  correctIndex Int    @map("correct_index")

  material EducationMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, order])
  @@map("education_quiz_questions")
}

/// Aktivitas edukasi per responden per materi (FR-R-05).
model EducationProgress {
  id             String    @id @default(uuid()) @db.Uuid
  respondentId   String    @map("respondent_id") @db.Uuid
  materialId     String    @map("material_id") @db.Uuid
  readAt         DateTime  @default(now()) @map("read_at") @db.Timestamptz(3)
  /// Skor kuis percobaan pertama dan terakhir (0–100).
  firstQuizScore Float?    @map("first_quiz_score")
  lastQuizScore  Float?    @map("last_quiz_score")
  quizAttempts   Int       @default(0) @map("quiz_attempts")
  lastAnswers    Json?     @map("last_answers")
  lastQuizAt     DateTime? @map("last_quiz_at") @db.Timestamptz(3)

  respondent Respondent        @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  material   EducationMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([respondentId, materialId])
  @@map("education_progress")
}
